# 又拍云服务名（bucket）
UPYUN_BUCKET=your-bucket

# 又拍云操作员
UPYUN_OPERATOR=your-operator

# 操作员密码
UPYUN_PASSWORD=your-password

# 可选：部署到远端哪个目录，默认根目录
UPYUN_REMOTE_ROOT=/

# 可选：是否删除远端存在但本地已不存在的文件，默认 true
UPYUN_DELETE_STALE=true

# 可选：上传并发数，默认 8
UPYUN_CONCURRENCY=8

# 可选：只打印计划，不上传/删除
UPYUN_DRY_RUN=false

# 可选：构建目录，默认 dist
UPYUN_DIST_DIR=dist

# 可选：不参与清理的远端前缀，逗号分隔
UPYUN_PROTECTED_PREFIXES=/upyun_storage_log_
