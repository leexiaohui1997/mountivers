generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  READY
  PROCESSING
  DONE
}

enum ArticleStatus {
  READY
  DATA_DONE
  IMAGE_DONE
  PUBLISHED
  FAILED
}

model Book {
  id               String     @id @default(cuid())
  path             String
  overview         Json?
  articles         Article[]
  status           BookStatus @default(READY)
  sessionUrl       String?
  toutiaoCoverPath String?
  xhsCoverPath     String?
  tags             Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Article {
  id         String        @id @default(cuid())
  index      Int
  data       Json?
  bookId     String
  book       Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status     ArticleStatus @default(READY)
  /**
   * 已失败的生成尝试次数；达到上限后置 FAILED
   */
  attempts   Int           @default(0)
  /**
   * 最近一次失败原因，便于排查与人工重置
   */
  lastError  String?
  /**
   * 成稿生成所用的元宝会话地址，便于回溯与续聊
   */
  sessionUrl String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([bookId, index])
}
