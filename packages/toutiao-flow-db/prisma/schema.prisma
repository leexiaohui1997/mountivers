generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  READY
  PROCESSING
  DONE
}

enum ArticleStatus {
  READY
  DATA_DONE
  IMAGE_DONE
  IMAGE_FAILED
  PUBLISHED
  FAILED
}

model Book {
  id                         String     @id @default(cuid())
  path                       String
  overview                   Json?
  articles                   Article[]
  status                     BookStatus @default(READY)
  sessionUrl                 String?
  toutiaoCoverPath           String?
  xhsCoverPath               String?
  /**
   * 头条合集是否已创建并确认存在
   */
  toutiaoCollectionCreated   Boolean    @default(false)
  /**
   * 头条合集创建失败次数；达到上限后不再自动重试
   */
  toutiaoCollectionAttempts  Int        @default(0)
  /**
   * 最近一次头条合集创建失败原因
   */
  toutiaoCollectionLastError String?
  tags                       Json?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
}

model Article {
  id             String        @id @default(cuid())
  index          Int
  data           Json?
  bookId         String
  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status         ArticleStatus @default(READY)
  /**
   * 已失败的生成尝试次数；仅用于观测，不设上限（成稿会一直重试到通过校验）
   */
  attempts       Int           @default(0)
  /**
   * 最近一次失败原因，便于排查与人工重置
   */
  lastError      String?
  /**
   * 配图生成失败的轮次；仅用于观测，不设上限（配图会一直重试到全部生成）
   */
  imageAttempts  Int           @default(0)
  /**
   * 最近一次配图生成失败原因
   */
  imageLastError String?
  /**
   * 成稿生成所用的元宝会话地址，便于回溯与续聊
   */
  sessionUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([bookId, index])
}
