generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  READY
  PROCESSING
  DONE
}

enum ArticleStatus {
  READY
  DATA_DONE
  IMAGE_DONE
  PUBLISHED
}

model Book {
  id               String     @id @default(cuid())
  path             String
  overview         Json?
  articles         Article[]
  status           BookStatus @default(READY)
  sessionUrl       String?
  toutiaoCoverPath String?
  xhsCoverPath     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Article {
  id        String        @id @default(cuid())
  index     Int
  data      Json?
  bookId    String
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status    ArticleStatus @default(READY)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
