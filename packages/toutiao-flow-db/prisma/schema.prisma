generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  READY
  PROCESSING
  DONE
}

enum ArticleStatus {
  READY
  DATA_DONE
  IMAGE_DONE
  IMAGE_FAILED
  PUBLISHED
  PUBLISH_FAILED
  FAILED
}

model Book {
  id                         String          @id @default(cuid())
  path                       String
  overview                   Json?
  articles                   Article[]
  microHeadlines             MicroHeadline[]
  status                     BookStatus      @default(READY)
  sessionUrl                 String?
  toutiaoCoverPath           String?
  xhsCoverPath               String?
  /**
   * 头条合集是否已创建并确认存在
   */
  toutiaoCollectionCreated   Boolean         @default(false)
  /**
   * 头条合集创建失败次数；达到上限后不再自动重试
   */
  toutiaoCollectionAttempts  Int             @default(0)
  /**
   * 最近一次头条合集创建失败原因
   */
  toutiaoCollectionLastError String?
  tags                       Json?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model Article {
  id               String        @id @default(cuid())
  index            Int
  data             Json?
  bookId           String
  book             Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status           ArticleStatus @default(READY)
  /**
   * 已失败的生成尝试次数；仅用于观测，不设上限（成稿会一直重试到通过校验）
   */
  attempts         Int           @default(0)
  /**
   * 最近一次失败原因，便于排查与人工重置
   */
  lastError        String?
  /**
   * 配图生成失败的轮次；仅用于观测，不设上限（配图会一直重试到全部生成）
   */
  imageAttempts    Int           @default(0)
  /**
   * 最近一次配图生成失败原因
   */
  imageLastError   String?
  /**
   * 成稿生成所用的元宝会话地址，便于回溯与续聊
   */
  sessionUrl       String?
  /**
   * 头条发布失败次数；达到上限后置 PUBLISH_FAILED
   */
  publishAttempts  Int           @default(0)
  /**
   * 最近一次头条发布失败原因
   */
  publishLastError String?
  /**
   * 头条实际发布时间
   */
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([bookId, index])
}

/// 通用键值状态表（如 toutiao-publish-limit）
model AppState {
  key   String  @id
  value String?
}

/// 微头条：以书籍为材料的独立短内容
model MicroHeadline {
  id             String   @id @default(uuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  data           Json?
  /// 三张配图是否全部完成
  imagesDone     Boolean  @default(false)
  /// 生图失败次数，仅用于观测；不设上限
  imageAttempts  Int      @default(0)
  /// 最近一次生图失败原因
  imageLastError String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookId])
  @@index([imagesDone, createdAt])
}
